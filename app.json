{
  "expo": {
    "name": "Linka",
    "slug": "Linka",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "linka",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#05614E",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4A62A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.nnedu.Linka"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#05614E",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 96,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#05614E",
            "image": "./assets/images/splash-logo.png"
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Linka needs access to your photos so you can add logos and product images.",
          "cameraPermission": "Linka needs the camera for identity verification selfies.",
          "microphonePermission": false
        }
      ],
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "infoPlist": {
        "CADisableMinimumFrameDurationOnPhone": true
      },
      "bundleIdentifier": "com.nnedu.Linka"
    }
  }
}
